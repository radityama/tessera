{
  "name": "@tessera-dev/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "echo ok",
    "lint": "eslint . && prettier --check src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tessera-dev/registry": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "prettier": "^3.5.3",
    "eslint": "^9.23.0"
  },
  "description": "Search, ranking, score explanations and provider-neutral artifact retrieval for Tessera.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radityama/tessera.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/radityama/tessera#readme",
  "bugs": {
    "url": "https://github.com/radityama/tessera/issues"
  },
  "keywords": [
    "mcp",
    "ui-components",
    "search",
    "ranking",
    "retrieval",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
