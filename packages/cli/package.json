{
  "name": "@tessera-dev/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "tessera": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "echo ok",
    "lint": "eslint . && prettier --check src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tessera-dev/core": "workspace:*",
    "@tessera-dev/mcp": "workspace:*",
    "@tessera-dev/registry": "workspace:*",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4",
    "prettier": "^3.5.3",
    "eslint": "^9.23.0"
  },
  "description": "Tessera command line: search, inspect and fetch real UI components, and start the MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/radityama/tessera.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/radityama/tessera#readme",
  "bugs": {
    "url": "https://github.com/radityama/tessera/issues"
  },
  "keywords": [
    "cli",
    "mcp",
    "ui-components",
    "shadcn",
    "developer-tools",
    "ai-agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
