{
  "name": "tessera",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "registry:sync": "pnpm --filter @tessera-dev/adapters build && pnpm --filter @tessera-dev/adapters sync",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "mcp:conformance": "node scripts/mcp-conformance.mjs",
    "release:check": "node scripts/release-check.mjs",
    "dogfood": "node scripts/dogfood.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "eslint": "^9.23.0",
    "prettier": "^3.5.3",
    "turbo": "^2.11.7",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
